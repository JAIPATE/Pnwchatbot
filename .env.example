# PostgreSQL Database Connection for pgvector
DATABASE_URL=postgresql://pnw_admin:pnw_secret_2026@localhost:5432/pnw_knowledge_db

# Vector Database Backend: "pgvector" (recommended) or "sqlite"
VECTOR_BACKEND=pgvector

# RAG Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
CHUNK_SIZE=500
CHUNK_OVERLAP=80
